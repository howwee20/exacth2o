  "id": 4402857,
  "commit": "d80163dffc3108f193e831d72fcfa899",
  "composition": {
    "version": "2.4",
    "volumes": {
      "db_data": {},
      "database": {},
      "redis_data": {},
      "cron_config": {},
      "health_data": {},
      "publisher_data": {}
    },
    "services": {
      "ui_svc": {
        "build": {
          "context": "./ui_svc-reuse",
          "dockerfile": "Dockerfile"
        },
        "ports": [
          "80:80/tcp"
        ],
        "expose": [
          "80"
        ],
        "restart": "always",
        "depends_on": [
          "api_svc",
          "health_svc"
        ],
        "environment": {
          "PORT": "80",
          "API_URL": "http://api_svc:8888/v1"
        },
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost"
          ],
          "retries": 5,
          "timeout": "30s",
          "interval": "30s"
        }
      },
      "api_svc": {
        "build": {
          "context": "./api_svc-reuse",
          "dockerfile": "Dockerfile"
        },
        "expose": [
          "8888"
        ],
        "devices": [
          "/dev/i2c-1:/dev/i2c-1",
          "/dev/mem:/dev/mem",
          "/dev/gpiomem:/dev/gpiomem"
        ],
        "restart": "always",
        "depends_on": [
          "database_svc"
        ],
        "privileged": true,
        "environment": {
          "PORT": "8888",
          "CRON_URL": "http://cron_svc:3000/v1"
        },
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost:8888/v1/healthcheck"
          ],
          "retries": 5,
          "timeout": "30s",
          "interval": "30s"
        }
      },
      "cron_svc": {
        "build": {
          "context": "./cron-patch",
          "dockerfile": "Dockerfile"
        },
        "devices": [
          "/dev/i2c-1:/dev/i2c-1",
          "/dev/mem:/dev/mem",
          "/dev/gpiomem:/dev/gpiomem"
        ],
        "restart": "always",
        "volumes": [
          "cron_config:/app/config"
        ],
        "depends_on": [
          "api_svc",
          "redis_svc"
        ],
        "privileged": true,
        "environment": {
          "PORT": "3000",
          "API_URL": "http://api_svc:8888",
          "REDIS_HOST": "redis_svc",
          "REDIS_PORT": "6379",
          "API_FETCH_RETRIES": "90",
          "SDI12_CONFIG_PATH": "/app/config/sdi12-config.json",
          "MIN_WATERING_RETRY_MS": "1800000",
          "VALVE_RECOVERY_DELAY_MS": "30000",
          "API_FETCH_RETRY_DELAY_MS": "2000",
          "WATERING_SETTLE_WINDOW_MS": "3600000",
          "AUTOMATIC_PULSE_LEDGER_PATH": "/app/config/automatic-pulses.json",
          "MAX_WATERING_PULSES_PER_SETTLE_WINDOW": "2"
        }
      },
      "redis_svc": {
        "build": {
          "context": "./redis_svc-reuse",
          "dockerfile": "Dockerfile"
        },
        "expose": [
          "6379"
        ],
        "restart": "unless-stopped",
        "volumes": [
          "redis_data:/data"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "redis-cli",
            "ping"
          ],
          "retries": 5,
          "timeout": "10s",
          "interval": "30s"
        }
      },
      "health_svc": {
        "build": {
          "context": "./health_svc-reuse",
          "dockerfile": "Dockerfile"
        },
        "ports": [
          "8767:8767/tcp"
        ],
        "expose": [
          "8767"
        ],
        "labels": {
          "io.balena.features.sysfs": "1",
          "io.balena.features.procfs": "1",
          "io.balena.features.balena-socket": "1"
        },
        "devices": [
          "/dev/i2c-1:/dev/i2c-1",
          "/dev/mem:/dev/mem",
          "/dev/gpiomem:/dev/gpiomem"
        ],
        "restart": "always",
        "volumes": [
          "health_data:/data"
        ],
        "depends_on": [
          "api_svc",
          "redis_svc"
        ],
        "privileged": true,
        "environment": {
          "HOST": "0.0.0.0",
          "PORT": "8767",
          "PI_I2C_BUS": "1",
          "PI_API_BASE": "http://api_svc:8888",
          "PI_HOST_SYS": "/sys",
          "PI_HOST_PROC": "/proc",
          "PI_ETH_DEVICE": "eth0",
          "PI_PUBLIC_URL": "https://3100e37ee3205651fe3dd86dafd4dc0c.balena-devices.com",
          "PI_REDIS_HOST": "redis_svc",
          "PI_REDIS_PORT": "6379",
          "PUBLIC_BASE_PATH": "/owner-health",
          "PI_CONTROLLER_IPV4": "35.8.86.10",
          "PI_DEVICE_API_BASE": "http://api_svc:8888",
          "PI_EXPECTED_BOARDS": "0x20,0x24,0x26",
          "HEALTH_HISTORY_FILE": "/data/health-history.jsonl",
          "PI_EXPECTED_SERVICES": "api_svc,ui_svc,cron_svc,database_svc,redis_svc,health_svc,control_executor,supabase_publisher",
          "OWNER_ALERT_STATE_FILE": "/data/owner-alert-state.json",
          "PI_DEVICE_SSH_FALLBACK": "0",
          "DASHBOARD_COOKIE_SECURE": "1",
          "PI_SCHEDULER_HEALTH_SOURCE": "redis",
          "PI_SCHEDULER_HEALTH_ENABLED": "1",
          "HEALTH_HISTORY_RETENTION_DAYS": "21",
          "PI_REMOTE_HOST_HEALTH_ENABLED": "0",
          "HEALTH_HISTORY_SAMPLE_INTERVAL_SECONDS": "300"
        },
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost:8767/api/livez"
          ],
          "retries": 5,
          "timeout": "30s",
          "interval": "30s"
        }
      },
      "database_svc": {
        "build": {
          "context": "./database_svc-reuse",
          "dockerfile": "Dockerfile"
        },
        "expose": [
          "3306"
        ],
        "restart": "unless-stopped",
        "volumes": [
          "database:/docker-entrypoint-initdb.d",
          "db_data:/var/lib/mysql"
        ],
        "environment": {
          "MYSQL_DATABASE": "walkerlabs",
          "MARIADB_DATABASE": "walkerlabs"
        },
        "healthcheck": {
          "test": [
            "CMD",
            "/scripts/healthcheck.sh"
          ],
          "retries": 5,
          "timeout": "30s",
          "interval": "30s"
        }
      },
      "control_executor": {
        "build": {
          "context": "./control_executor-reuse",
          "dockerfile": "Dockerfile"
        },
        "restart": "always",
        "depends_on": [
          "api_svc",
          "cron_svc",
          "health_svc"
        ],
        "environment": {
          "EXACTH2O_DEVICE_ID": "3100e37ee3205651fe3dd86dafd4dc0c",
          "EXACTH2O_PROJECT_ID": "22222222-2222-4222-8222-222222222222",
          "EXACTH2O_STATE_SYNC_MS": "120000",
          "EXACTH2O_LOCAL_API_BASE": "http://api_svc:8888/v1",
          "EXACTH2O_MANUAL_WATER_ENABLED": "0",
          "EXACTH2O_SYNC_OWNER_HEALTH_URL": "https://zmhdclcjrkntrpynozvo.supabase.co/functions/v1/sync-owner-health",
          "EXACTH2O_CONTROL_EXECUTOR_DRY_RUN": "1",
          "EXACTH2O_CONTROL_EXECUTOR_POLL_MS": "5000",
          "EXACTH2O_MANUAL_WATER_MAX_SECONDS": "60",
          "EXACTH2O_CONTROL_EXECUTOR_RETRY_MAX_MS": "60000",
          "EXACTH2O_MANUAL_WATER_MAX_VALVE_SECONDS": "120"
        }
      },
      "supabase_publisher": {
        "build": {
          "context": "./supabase_publisher-reuse",
          "dockerfile": "Dockerfile"
        },
        "restart": "always",
        "volumes": [
          "publisher_data:/data"
        ],
        "depends_on": [
          "api_svc"
        ],
        "environment": {
          "EXACTH2O_DEVICE_ID": "3100e37ee3205651fe3dd86dafd4dc0c",
          "EXACTH2O_PROJECT_ID": "22222222-2222-4222-8222-222222222222",
          "EXACTH2O_LOCAL_API_BASE": "http://api_svc:8888/v1",
          "EXACTH2O_PUBLISHER_STATE": "/data/publisher-state.json",
          "EXACTH2O_PUBLISHER_HEALTH": "/data/publisher-health.json",
          "EXACTH2O_INGEST_BATCH_SIZE": "200",
          "EXACTH2O_READINGS_PAGE_SIZE": "500",
          "EXACTH2O_PUBLISH_INTERVAL_MS": "30000",
          "EXACTH2O_RECONCILE_MAX_PAGES": "4",
          "EXACTH2O_PAIRING_HISTORY_PATH": "/app/config/pairing-history.json",
          "EXACTH2O_PUBLISHER_RETRY_MAX_MS": "60000",
          "EXACTH2O_PUBLISHER_RETRY_MIN_MS": "2000",
          "EXACTH2O_PUBLISHER_HEALTH_STALE_MS": "180000",
          "EXACTH2O_PUBLISHER_CATCHUP_DELAY_MS": "1000",
          "EXACTH2O_PUBLISHER_REQUEST_TIMEOUT_MS": "30000"
        },
        "healthcheck": {
          "test": [
            "CMD",
            "node",
            "src/healthcheck.mjs"
          ],
          "retries": 5,
          "timeout": "10s",
          "interval": "30s",
          "start_period": "30s"
        }
      }
    }
  },
  "status": "success"
}